@page
@model ActivateModel
@{
    ViewData["Title"] = Localizer["Activate_Title"];
}

@switch (Model.State)
{
    case ActivationState.Ready:
        <p>@Localizer["Activate_Ready"]</p>
        <form method="post">
            <input type="hidden" asp-for="Token" />
            <button type="submit" class="button">@Localizer["Activate_Button"]</button>
        </form>
        break;

    case ActivationState.Activated:
        <p class="status status-success">@Localizer["Activate_Success"]</p>
        <p>@Localizer["Activate_SuccessHint"]</p>
        break;

    case ActivationState.Failed:
        <p class="status status-error">@Model.Error</p>
        <p>@Localizer["Activate_ExpiredHint"]</p>
        break;
}
