@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}

@if (Model.Completed)
{
    <p class="status status-success">Your password was updated.</p>
    <p>Go back to the app and log in with your new password.</p>
}
else if (string.IsNullOrWhiteSpace(Model.Token))
{
    <p class="status status-error">This link is incomplete. Open it again from the email.</p>
}
else
{
    @if (Model.Error is not null)
    {
        <p class="status status-error">@Model.Error</p>
    }

    <form method="post" novalidate>
        <input type="hidden" asp-for="Token" />

        <div class="field">
            <label asp-for="Password">New password</label>
            <input asp-for="Password" type="password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword">Confirm password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <p class="hint">At least 8 characters, with one uppercase letter and one digit.</p>
        <button type="submit" class="button">Save password</button>
    </form>
}
