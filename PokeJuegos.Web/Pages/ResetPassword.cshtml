@page
@model ResetPasswordModel
@{
    ViewData["Title"] = Localizer["Reset_Title"];
}

@if (Model.Completed)
{
    <p class="status status-success">@Localizer["Reset_Success"]</p>
    <p>@Localizer["Reset_SuccessHint"]</p>
}
else if (string.IsNullOrWhiteSpace(Model.Token))
{
    <p class="status status-error">@Localizer.Error("LINK_INCOMPLETE")</p>
}
else
{
    @if (Model.Error is not null)
    {
        <p class="status status-error">@Model.Error</p>
    }

    <form method="post" novalidate>
        <input type="hidden" asp-for="Token" />

        <div class="field">
            <label asp-for="Password">@Localizer["Reset_NewPassword"]</label>
            <input asp-for="Password" type="password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword">@Localizer["Reset_ConfirmPassword"]</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <p class="hint">@Localizer["Reset_Hint"]</p>
        <button type="submit" class="button">@Localizer["Reset_Button"]</button>
    </form>
}
