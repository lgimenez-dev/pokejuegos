{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=pokejuegos;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Secret": "YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG",
    "ExpirationMinutes": 60
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "App": {
    "Name": "PokeJuegos",
    "FrontendUrl": "http://localhost:3000",
    "MobileRedirectUri": "pokejuegos://oauth"
  },
  "AllowedHosts": "*"
}
