<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:PokeJuegos.Mobile.Resources.Strings"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:PokeJuegos.Mobile.ViewModels"
             x:Class="PokeJuegos.Mobile.Views.GeneralPage"
             x:DataType="vm:GeneralViewModel"
             SafeAreaEdges="All">

    <!-- Port of GeneralView / general.tsx: the game selector, plus the settings gear (not in the web). -->
    <Grid>
    <ImageButton Source="settings_icon.png"
                 Command="{Binding OpenSettingsCommand}"
                 WidthRequest="32"
                 HeightRequest="32"
                 Margin="0,25,25,0"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 BackgroundColor="Transparent"
                 SemanticProperties.Description="{x:Static strings:AppResources.A11y_Settings}">
        <ImageButton.Behaviors>
            <toolkit:IconTintColorBehavior TintColor="{StaticResource DarkGray}" />
        </ImageButton.Behaviors>
    </ImageButton>

    <VerticalStackLayout Padding="24"
                         Spacing="32"
                         MaximumWidthRequest="384"
                         VerticalOptions="Center">

        <Label Text="{x:Static strings:AppResources.General_Title}"
               Style="{StaticResource SubtitleLabel}"
               SemanticProperties.HeadingLevel="Level1" />

        <VerticalStackLayout Spacing="16">
            <Button Text="{x:Static strings:AppResources.Game_Pokedex}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding OpenPokedexCommand}" />
            <Button Text="{x:Static strings:AppResources.Game_Roulette}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding OpenRouletteCommand}" />
        </VerticalStackLayout>
    </VerticalStackLayout>
    </Grid>

</ContentPage>
