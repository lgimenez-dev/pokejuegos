<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PokeJuegos.Mobile.ViewModels"
             x:Class="PokeJuegos.Mobile.Views.GeneralPage"
             x:DataType="vm:GeneralViewModel"
             SafeAreaEdges="All">

    <!-- Port of GeneralView / general.tsx: the game selector. -->
    <VerticalStackLayout Padding="24"
                         Spacing="32"
                         MaximumWidthRequest="384"
                         VerticalOptions="Center">

        <Label Text="Choose a game"
               Style="{StaticResource SubtitleLabel}"
               SemanticProperties.HeadingLevel="Level1" />

        <VerticalStackLayout Spacing="16">
            <Button Text="Pokédex"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding OpenPokedexCommand}" />
            <Button Text="Who's That Pokémon?"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding OpenRouletteCommand}" />
        </VerticalStackLayout>
    </VerticalStackLayout>

</ContentPage>
