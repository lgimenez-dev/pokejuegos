<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:PokeJuegos.Mobile.Resources.Strings"
             xmlns:vm="clr-namespace:PokeJuegos.Mobile.ViewModels"
             xmlns:controls="clr-namespace:PokeJuegos.Mobile.Controls"
             x:Class="PokeJuegos.Mobile.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             SafeAreaEdges="All">

    <Grid>
        <!-- ScrollView so the fields stay reachable when the on-screen keyboard opens. -->
        <ScrollView>
            <!-- Same column as LoginPage (LoginView.vue): 31.5rem wide, 3rem between blocks. -->
            <VerticalStackLayout Padding="0,24"
                                 Spacing="30"
                                 WidthRequest="315"
                                 VerticalOptions="Center">

                <Label Text="{x:Static strings:AppResources.Register_Title}"
                       Style="{StaticResource SubtitleLabel}"
                       SemanticProperties.HeadingLevel="Level1" />

                <VerticalStackLayout Spacing="20">
                    <controls:FormEntry Text="{Binding Name}"
                                        ErrorText="{Binding NameError}"
                                        Placeholder="{x:Static strings:AppResources.Common_Name}"
                                        Keyboard="Text"
                                        ReturnType="Next" />
                    <controls:FormEntry Text="{Binding Username}"
                                        ErrorText="{Binding UsernameError}"
                                        Placeholder="{x:Static strings:AppResources.Common_Username}"
                                        ReturnType="Next" />
                    <controls:FormEntry Text="{Binding Email}"
                                        ErrorText="{Binding EmailError}"
                                        Placeholder="{x:Static strings:AppResources.Common_Email}"
                                        Keyboard="Email"
                                        ReturnType="Next" />
                    <controls:FormEntry Text="{Binding Password}"
                                        ErrorText="{Binding PasswordError}"
                                        Placeholder="{x:Static strings:AppResources.Common_Password}"
                                        IsPassword="True"
                                        ReturnType="Next" />
                    <controls:FormEntry Text="{Binding ConfirmPassword}"
                                        ErrorText="{Binding ConfirmPasswordError}"
                                        Placeholder="{x:Static strings:AppResources.Common_ConfirmPassword}"
                                        IsPassword="True"
                                        ReturnType="Done" />
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Button Grid.Column="0"
                            Text="{x:Static strings:AppResources.Common_Back}"
                            Style="{StaticResource OutlineButton}"
                            HeightRequest="44"
                            Padding="0"
                            Command="{Binding BackToLoginCommand}" />
                    <Button Grid.Column="1"
                            Text="{x:Static strings:AppResources.Common_Register}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="44"
                            Padding="0"
                            Command="{Binding RegisterCommand}" />
                </Grid>

                <ActivityIndicator IsRunning="{Binding RegisterCommand.IsRunning}"
                                   IsVisible="{Binding RegisterCommand.IsRunning}"
                                   HeightRequest="32" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- The account stays pending until it's activated from the emailed link. -->
        <controls:ModalView Title="{x:Static strings:AppResources.Common_CheckYourEmail}"
                            IsOpen="{Binding IsSuccessOpen}"
                            CloseCommand="{Binding CloseSuccessCommand}">
            <VerticalStackLayout Spacing="20">
                <Label Text="{x:Static strings:AppResources.Register_SuccessMessage}"
                       Style="{StaticResource BodyLabel}"
                       HorizontalTextAlignment="Center" />
                <Button Text="{x:Static strings:AppResources.Common_Ok}"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="44"
                        Command="{Binding CloseSuccessCommand}" />
            </VerticalStackLayout>
        </controls:ModalView>
    </Grid>

</ContentPage>
