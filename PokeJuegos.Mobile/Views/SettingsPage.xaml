<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:PokeJuegos.Mobile.Resources.Strings"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:PokeJuegos.Mobile.ViewModels"
             xmlns:models="clr-namespace:PokeJuegos.Mobile.Models"
             xmlns:controls="clr-namespace:PokeJuegos.Mobile.Controls"
             x:Class="PokeJuegos.Mobile.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             SafeAreaEdges="All">

    <!-- No web counterpart: same column and styles as the login/register forms. -->
    <Grid>
        <ImageButton Source="left_icon.png"
                     Command="{Binding GoBackCommand}"
                     WidthRequest="36"
                     HeightRequest="36"
                     Margin="25,25,0,0"
                     HorizontalOptions="Start"
                     VerticalOptions="Start"
                     BackgroundColor="Transparent"
                     SemanticProperties.Description="{x:Static strings:AppResources.A11y_GoBack}">
            <ImageButton.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="{StaticResource DarkGray}" />
            </ImageButton.Behaviors>
        </ImageButton>

        <VerticalStackLayout Padding="0,24"
                             Spacing="30"
                             WidthRequest="315"
                             VerticalOptions="Center">

            <Label Text="{x:Static strings:AppResources.Settings_Title}"
                   Style="{StaticResource SubtitleLabel}"
                   SemanticProperties.HeadingLevel="Level1" />

            <VerticalStackLayout Spacing="12">
                <Label Text="{x:Static strings:AppResources.Settings_Language}"
                       Style="{StaticResource BodyLabel}"
                       HorizontalTextAlignment="Start" />
                <controls:OptionPicker ItemsSource="{Binding Languages}"
                                       SelectedItem="{Binding SelectedLanguage}"
                                       ItemDisplayBinding="{Binding Name, x:DataType=models:LanguageOption}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
