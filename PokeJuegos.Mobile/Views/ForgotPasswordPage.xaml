<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:PokeJuegos.Mobile.Resources.Strings"
             xmlns:vm="clr-namespace:PokeJuegos.Mobile.ViewModels"
             xmlns:controls="clr-namespace:PokeJuegos.Mobile.Controls"
             x:Class="PokeJuegos.Mobile.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             SafeAreaEdges="All">

    <Grid>
        <!-- ScrollView so the field stays reachable when the on-screen keyboard opens. -->
        <ScrollView>
            <!-- Same column as LoginPage (LoginView.vue): 31.5rem wide, 3rem between blocks. -->
            <VerticalStackLayout Padding="0,24"
                                 Spacing="30"
                                 WidthRequest="315"
                                 VerticalOptions="Center">

                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.Common_ForgotPassword}"
                           Style="{StaticResource SubtitleLabel}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{x:Static strings:AppResources.Forgot_Body}"
                           Style="{StaticResource BodyLabel}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="20">
                    <controls:FormEntry Text="{Binding Email}"
                                        ErrorText="{Binding EmailError}"
                                        Placeholder="{x:Static strings:AppResources.Common_Email}"
                                        Keyboard="Email"
                                        ReturnType="Done" />
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Button Grid.Column="0"
                            Text="{x:Static strings:AppResources.Common_Back}"
                            Style="{StaticResource OutlineButton}"
                            HeightRequest="44"
                            Padding="0"
                            Command="{Binding BackToLoginCommand}" />
                    <Button Grid.Column="1"
                            Text="{x:Static strings:AppResources.Forgot_Send}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="44"
                            Padding="0"
                            Command="{Binding SendCommand}" />
                </Grid>

                <ActivityIndicator IsRunning="{Binding SendCommand.IsRunning}"
                                   IsVisible="{Binding SendCommand.IsRunning}"
                                   HeightRequest="32" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- The API doesn't reveal whether the account exists, hence the "if". -->
        <controls:ModalView Title="{x:Static strings:AppResources.Common_CheckYourEmail}"
                            IsOpen="{Binding IsSuccessOpen}"
                            CloseCommand="{Binding CloseSuccessCommand}">
            <VerticalStackLayout Spacing="20">
                <Label Text="{x:Static strings:AppResources.Forgot_SuccessMessage}"
                       Style="{StaticResource BodyLabel}"
                       HorizontalTextAlignment="Center" />
                <Button Text="{x:Static strings:AppResources.Common_Ok}"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="44"
                        Command="{Binding CloseSuccessCommand}" />
            </VerticalStackLayout>
        </controls:ModalView>
    </Grid>

</ContentPage>
