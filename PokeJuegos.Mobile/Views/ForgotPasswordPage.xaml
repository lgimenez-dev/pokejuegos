<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PokeJuegos.Mobile.ViewModels"
             xmlns:controls="clr-namespace:PokeJuegos.Mobile.Controls"
             x:Class="PokeJuegos.Mobile.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             SafeAreaEdges="All">

    <Grid>
        <!-- ScrollView so the field stays reachable when the on-screen keyboard opens. -->
        <ScrollView>
            <!-- Same column as LoginPage (LoginView.vue): 31.5rem wide, 3rem between blocks. -->
            <VerticalStackLayout Padding="0,24"
                                 Spacing="30"
                                 WidthRequest="315"
                                 VerticalOptions="Center">

                <VerticalStackLayout Spacing="8">
                    <Label Text="Forgot your password?"
                           Style="{StaticResource SubtitleLabel}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Enter your account's email and we'll send you a link to reset your password. If you signed up with Google, the link lets you create one."
                           Style="{StaticResource BodyLabel}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="20">
                    <controls:FormEntry Text="{Binding Email}"
                                        ErrorText="{Binding EmailError}"
                                        Placeholder="Email"
                                        Keyboard="Email"
                                        ReturnType="Done" />
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Button Grid.Column="0"
                            Text="Back"
                            Style="{StaticResource OutlineButton}"
                            HeightRequest="44"
                            Padding="0"
                            Command="{Binding BackToLoginCommand}" />
                    <Button Grid.Column="1"
                            Text="Send link"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="44"
                            Padding="0"
                            Command="{Binding SendCommand}" />
                </Grid>

                <ActivityIndicator IsRunning="{Binding SendCommand.IsRunning}"
                                   IsVisible="{Binding SendCommand.IsRunning}"
                                   HeightRequest="32" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- The API doesn't reveal whether the account exists, hence the "if". -->
        <controls:ModalView Title="Check your email"
                            IsOpen="{Binding IsSuccessOpen}"
                            CloseCommand="{Binding CloseSuccessCommand}">
            <VerticalStackLayout Spacing="20">
                <Label Text="If there's an account with that email, we sent it a link. It expires in 30 minutes."
                       Style="{StaticResource BodyLabel}"
                       HorizontalTextAlignment="Center" />
                <Button Text="OK"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="44"
                        Command="{Binding CloseSuccessCommand}" />
            </VerticalStackLayout>
        </controls:ModalView>
    </Grid>

</ContentPage>
