<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PokeJuegos.Mobile.ViewModels"
             x:Class="PokeJuegos.Mobile.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             SafeAreaEdges="All">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="32"
                             MaximumWidthRequest="512"
                             VerticalOptions="Center">

            <!--
                Illustration over a primary-colored circle. The SVG (318x262) masks Pikachu's bottom
                with a circle centered at (145.2, 159), radius 103, touching the bottom edge; the
                background circle reuses that exact geometry, so the cut edge always lines up.
                Size is set only here (keep the 318:262 ratio); both children scale proportionally:
                  width  206/318 = 0.6478   x = (145.2-103) / (318-206) = 0.3766
                  height 206/262 = 0.7863   y = 1 (circle bottom = image bottom)
            -->
            <AbsoluteLayout WidthRequest="280" HeightRequest="231" HorizontalOptions="Center">
                <Ellipse AbsoluteLayout.LayoutBounds="0.3766,1,0.6478,0.7863"
                         AbsoluteLayout.LayoutFlags="All"
                         Fill="{StaticResource PrimaryBrush}" />
                <Image Source="home_image.png"
                       AbsoluteLayout.LayoutBounds="0,0,1,1"
                       AbsoluteLayout.LayoutFlags="All"
                       Aspect="AspectFit"
                       SemanticProperties.Description="Pikachu waving" />
            </AbsoluteLayout>

            <Label Text="Welcome to PokeJuegos"
                   Style="{StaticResource TitleLabel}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="A hub of Pokémon-themed minigames — Pokédex, quizzes and more, all in one place."
                   Style="{StaticResource BodyLabel}" />

            <Button Text="Get Started"
                    Style="{StaticResource PrimaryButton}"
                    WidthRequest="224"
                    HorizontalOptions="Center"
                    Command="{Binding GetStartedCommand}" />

            <Label Text="Fan-made project. Not affiliated with or endorsed by Nintendo, Game Freak or The Pokémon Company."
                   Style="{StaticResource CaptionLabel}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
