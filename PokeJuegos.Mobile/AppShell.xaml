<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PokeJuegos.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PokeJuegos.Mobile.Views"
    Title="PokeJuegos">

    <!--
        Root destinations (navigate with "//route" to reset the stack, e.g. after login).
        No tab bar or flyout: screens flow like the RN Stack without header.
    -->
    <ShellContent ContentTemplate="{DataTemplate views:WelcomePage}" Route="welcome" />
    <ShellContent ContentTemplate="{DataTemplate views:GeneralPage}" Route="general" />

</Shell>
