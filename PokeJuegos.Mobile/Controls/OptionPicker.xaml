<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PokeJuegos.Mobile.Controls"
             x:Class="PokeJuegos.Mobile.Controls.OptionPicker"
             x:Name="Root"
             x:DataType="controls:OptionPicker">

    <!--
        Port of BaseSelect.vue: pill-shaped white select, light gray border, 1.8rem dark gray text, chevron on
        the right. Disabled at 50% opacity.
    -->
    <ContentView.Triggers>
        <Trigger TargetType="controls:OptionPicker" Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.5" />
        </Trigger>
    </ContentView.Triggers>

    <Border Style="{StaticResource SelectBorder}">
        <Grid>
            <!-- Fills the whole pill so any tap opens it; the label and chevron on top let taps through. -->
            <Picker x:Name="InnerPicker"
                    ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                    SelectedItem="{Binding SelectedItem, Source={x:Reference Root}, Mode=TwoWay}"
                    Margin="20,0,0,0"
                    VerticalOptions="Center" />

            <!--
                Own placeholder instead of Picker.Title: on Windows the title is drawn as a header above the
                combo box, and on the web the placeholder is the select's first (disabled) option.
            -->
            <Label Text="{Binding Placeholder, Source={x:Reference Root}}"
                   IsVisible="{Binding HasNoSelection, Source={x:Reference Root}}"
                   FontSize="18"
                   Margin="20,0,40,0"
                   VerticalOptions="Center"
                   InputTransparent="True" />

            <!-- Windows' combo box draws its own chevron. -->
            <Image Source="chevron_down_icon.png"
                   WidthRequest="14"
                   HeightRequest="14"
                   Margin="0,0,16,0"
                   HorizontalOptions="End"
                   VerticalOptions="Center"
                   InputTransparent="True"
                   IsVisible="{OnPlatform Default=True, WinUI=False}" />
        </Grid>
    </Border>

</ContentView>
