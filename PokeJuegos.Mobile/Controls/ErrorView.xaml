<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PokeJuegos.Mobile.Controls"
             x:Class="PokeJuegos.Mobile.Controls.ErrorView"
             x:Name="Root"
             x:DataType="controls:ErrorView">

    <!-- Port of BaseError.vue: "Uh-oh!" title, the message and a way back. -->
    <VerticalStackLayout Padding="24,48" Spacing="8">
        <Label Text="Uh-oh!"
               Style="{StaticResource SubtitleLabel}"
               SemanticProperties.HeadingLevel="Level2" />
        <Label Text="{Binding ErrorMessage, Source={x:Reference Root}}"
               Style="{StaticResource BodyLabel}"
               TextColor="{StaticResource DarkGray}" />
        <Button Text="{Binding ButtonText, Source={x:Reference Root}}"
                Command="{Binding BackToHomeCommand, Source={x:Reference Root}}"
                Style="{StaticResource PrimaryButton}"
                WidthRequest="224"
                Margin="0,24,0,0"
                HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentView>
