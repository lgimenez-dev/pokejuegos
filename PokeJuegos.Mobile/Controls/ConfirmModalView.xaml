<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PokeJuegos.Mobile.Controls"
             x:Class="PokeJuegos.Mobile.Controls.ConfirmModalView"
             x:Name="Root"
             x:DataType="controls:ConfirmModalView">

    <!--
        Port of BaseConfirmModal.vue: BaseModal with a 1.6rem message and No (outline) / Yes (primary) buttons,
        4.6rem tall, 1.2rem apart, 2rem below the message. Closing the modal any other way counts as "No".
    -->
    <controls:ModalView Title="{Binding Title, Source={x:Reference Root}}"
                        IsOpen="{Binding IsOpen, Source={x:Reference Root}}"
                        CloseCommand="{Binding CancelCommand, Source={x:Reference Root}}">
        <VerticalStackLayout>
            <Label Text="{Binding Message, Source={x:Reference Root}}" FontSize="16" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,20,0,0">
                <Button Text="{Binding CancelLabel, Source={x:Reference Root}}"
                        Style="{StaticResource OutlineButton}"
                        HeightRequest="46"
                        CornerRadius="23"
                        Padding="0"
                        Command="{Binding CancelCommand, Source={x:Reference Root}}" />
                <Button Grid.Column="1"
                        Text="{Binding ConfirmLabel, Source={x:Reference Root}}"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="46"
                        CornerRadius="23"
                        Padding="0"
                        Command="{Binding ConfirmCommand, Source={x:Reference Root}}" />
            </Grid>
        </VerticalStackLayout>
    </controls:ModalView>

</ContentView>
